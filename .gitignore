# Terraform state — never commit, contains plaintext secrets
terraform.tfstate
terraform.tfstate.backup
.terraform.tfstate.lock.info

# Kubeconfig files generated by Terraform (kind provider writes these)
terraform/*-config
*kubeconfig*

# Terraform working directory (downloaded providers and modules)
**/.terraform/

# Variable files that may contain secrets
*.tfvars
*.tfvars.json

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# macOS
.DS_Store

# JetBrains IDE
.idea/
